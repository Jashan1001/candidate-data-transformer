{
    "fields": [
        {
            "path": "name",
            "from": "full_name",
            "required": true
        },
        {
            "path": "primary_email",
            "from": "emails[0]",
            "required": true
        },
        {
            "path": "phone",
            "from": "phones[0]",
            "normalize": "E164"
        },
        {
            "path": "tech_skills",
            "from": "skills[].name",
            "normalize": "canonical"
        },
        {
            "path": "github_profile",
            "from": "links.github"
        }
    ],
    "include_confidence": true,
    "include_provenance": false,
    "on_missing": "error"
}